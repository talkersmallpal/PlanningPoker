# ---- App ----
PORT=8080
# Protect "Start session" (strongly recommended when Jira is configured)
ADMIN_PASSWORD=change-me
# Default hours per story point shown on the start form (admin can change it per session at any time)
DEFAULT_RATE=4
# Hours (SP x rate) are rounded UP to the next multiple of this: 0.5 = half hours, 1 = whole hours
HOURS_ROUNDING_STEP=0.5
# Default session name on the start form (also used when left blank)
DEFAULT_SESSION_NAME=Estimation session
# Sessions are deleted after this many hours without activity
SESSION_TTL_HOURS=24
# A member who disconnects still counts for "everybody voted" for this many seconds (covers refreshes)
OFFLINE_GRACE_SECONDS=20
# Persist sessions across restarts (the Docker image defaults to /data/sessions.json; empty = memory only)
DATA_FILE=/data/sessions.json

# ---- Jira Cloud (optional; leave empty to use manual titles only) ----
JIRA_BASE_URL=https://url1
JIRA_EMAIL=
JIRA_API_TOKEN=
# Leave empty to auto-discover the "Story Points" / "Story point estimate" field via /rest/api/3/field
JIRA_STORY_POINTS_FIELD=
# Optional: true shows per-ticket "Save to Jira" buttons (UPDATE Jiras does not need this)
JIRA_WRITE_BACK=false
JIRA_WRITE_ORIGINAL_ESTIMATE=true
# Pre-filled JQL in the "Load from Jira" panel
JIRA_DEFAULT_JQL=sprint in openSprints() ORDER BY rank
# Optional default board for "Load from Jira", by name (exact match preferred, else first name containing it; a number = board id)
JIRA_DEFAULT_BOARD=
# Optional project key preselected in the Project dropdown (limits the board picker), e.g. PROJ
JIRA_DEFAULT_BOARD_PROJECT=
# (JIRA_DEFAULT_BOARD_ID still works as an alias of JIRA_DEFAULT_BOARD)
JIRA_TIMEOUT_SECONDS=15
# When time is written, also set Remaining estimate = max(0, new Original estimate - time logged); false = Original estimate only
JIRA_RECALC_REMAINING=true
# Default selection of "Update in Jira" (UPDATE Jiras): sp | time | both (admin can change it per update)
JIRA_UPDATE_DEFAULT_MODE=both
